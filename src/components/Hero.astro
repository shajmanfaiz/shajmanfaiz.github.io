---
import { data } from '../lib/data.js';
const { locale = 'en' } = Astro.props;
const t = data(locale);
const isAr = locale === 'ar';
---
<section id="hero" class="pt-[56px]">
  <div class="container-narrow">
    <div class="py-16 md:py-24 border-b" style="border-color: var(--border)">
      <div class="max-w-3xl" style={`direction: ${isAr ? 'rtl' : 'ltr'}`}>
        <p class="label mb-4">{t.greeting} 👋</p>
        <h1 class="text-[2.6rem] md:text-[3.4rem] font-bold tracking-[-0.04em] leading-[0.95] mb-4" style="color: var(--fg)">
          {t.name}
          <span class="block text-[1.1rem] md:text-[1.25rem] font-medium tracking-tight mt-3" style="color: var(--fg-2)">{t.position}</span>
        </h1>
        <div class="flex flex-wrap gap-3 mb-8">
          <a href={`mailto:${t.email}`} class="btn-invert">{t.contactButtonText} <span aria-hidden>→</span></a>
          <a href={t.resumeLink} target="_blank" rel="noopener noreferrer" class="btn-ghost">{t.resumeButtonText}</a>
        </div>
        <div class="flex gap-3">
          {t.socialMedia.map((s) => {
            const isGithub = s.socialMedia?.toLowerCase().includes('github');
            const isLinked = s.socialMedia?.toLowerCase().includes('linkedin');
            return (
              <a href={s.link} target="_blank" rel="noopener noreferrer" aria-label={s.socialMedia} class="w-10 h-10 rounded-full flex items-center justify-center border hover:opacity-70 transition-opacity" style="border-color: var(--border); color: var(--fg); background: var(--bg)">
                {isGithub ? (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.04C6.48 2.04 2 6.36 2 10.69c0 3.82 2.5 7.05 5.97 8.19.44.08.6-.19.6-.42v-1.5c-2.43.52-2.94-1.03-2.94-1.03-.4-1-.97-1.27-.97-1.27-.8-.54.06-.53.06-.53.88.06 1.34.89 1.34.89.78 1.32 2.05.94 2.55.72.08-.56.3-.94.55-1.15-1.94-.21-3.98-.95-3.98-4.24 0-.94.34-1.71.9-2.31-.09-.21-.39-1.07.09-2.24 0 0 .73-.23 2.4.88.71-.19 1.46-.29 2.21-.29.75 0 1.5.1 2.21.29 1.67-1.11 2.4-.88 2.4-.88.48 1.17.18 2.03.09 2.24.56.6.9 1.37.9 2.31 0 3.3-2.04 4.02-3.99 4.24.32.27.6.8.6 1.61v2.39c0 .23.16.5.6.42A12.03 12.03 0 0 0 22 10.69C22 6.36 17.52 2.04 12 2.04z"/></svg>
                ) : isLinked ? (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                ) : (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
