---
import { Image } from 'astro:assets';
import { data } from '../lib/data.js';
import nexaflowImg from '../assets/nexaflowengg_website.webp';
import ioticsImg from '../assets/iotics.webp';
import samamchImg from '../assets/samamch_binhendi.webp';
import githubImg from '../assets/shajman_github.webp';
import safaribyteImg from '../assets/safaribyte_website.webp';
import jobhunterImg from '../assets/job_hunter_ai_app.webp';
import atsImg from '../assets/ats_resume_app.webp';

const { locale = 'en' } = Astro.props;
const t = data(locale);
const isAr = locale === 'ar';

const imageMap = {
  'assets/nexaflowengg_website.webp': nexaflowImg,
  'assets/iotics.webp': ioticsImg,
  'assets/samamch_binhendi.webp': samamchImg,
  'assets/shajman_github.webp': githubImg,
  'assets/safaribyte_website.webp': safaribyteImg,
  'assets/job_hunter_ai_app.webp': jobhunterImg,
  'assets/ats_resume_app.webp': atsImg,
};

// dedup
function dedup(projects) {
  const seen = new Set();
  const out = [];
  for (const p of projects) {
    const key = p.title.trim().toLowerCase();
    if (!seen.has(key)) { seen.add(key); out.push(p); }
  }
  return out;
}
const projects = dedup(t.projects || []);
const doubled = [...projects, ...projects]; // CSS seamless needs double - hidden from badge count
---
<section id="projects" class="section-pad overflow-hidden" style="background: var(--bg-2)">
  <div class="container-narrow">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8" style={`direction: ${isAr ? 'rtl' : 'ltr'}`}>
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight" style="color: var(--fg)">{t.projectsTitle}</h2>
        <p class="text-[15px] md:text-[16px] mt-2" style="color: var(--fg-2)">{t.projectsSubtitle}</p>
      </div>
    </div>
  </div>

  <div class="marquee" role="region" aria-label={t.projectsTitle} aria-roledescription="carousel" data-marquee>
    <div class="marquee-track" style={`--marquee-duration: ${Math.max(20, projects.length * 6)}s`}>
      {doubled.map((p, idx) => {
        const isClone = idx >= projects.length;
        return (
          <article class="mono-card rounded-2xl overflow-hidden flex flex-col group shrink-0 w-[300px] sm:w-[340px] md:w-[360px]" aria-hidden={isClone ? 'true' : undefined} inert={isClone ? true : undefined}>
            <div class="aspect-[16/10] w-full overflow-hidden bg-[var(--bg-3)] border-b" style="border-color: var(--border)">
              {imageMap[p.imgSrc] ? (
                <Image
                  src={imageMap[p.imgSrc]}
                  alt={p.title}
                  width={360}
                  height={225}
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  loading={idx < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <img
                  src={p.imgSrc?.startsWith('assets/') ? `/${p.imgSrc}` : p.imgSrc}
                  alt={p.title}
                  width="360"
                  height="225"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  loading={idx < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  onerror="this.style.display='none'"
                />
              )}
            </div>
            <div class="p-5 flex flex-col gap-3 flex-1">
              <h3 class="text-[16px] md:text-[17px] font-semibold leading-tight" style="color: var(--fg)">{p.title}</h3>
              <p class="text-[14px] md:text-[15px] leading-6 md:leading-7 line-clamp-2" style="color: var(--fg-2)">{p.description}</p>
              {p.technologies && p.technologies.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {p.technologies.slice(0,4).map((tech) => (
                    <span class="text-[10px] font-semibold px-2 py-1 rounded-full border" style="border-color: var(--border); color: var(--fg-3); background: var(--bg-2)">{tech}</span>
                  ))}
                  {p.technologies.length > 4 && <span class="text-[10px] px-2 py-1" style="color: var(--fg-3)">+{p.technologies.length - 4}</span>}
                </div>
              )}
              <div class="flex gap-2 mt-auto pt-2">
                <a href={p.link} target="_blank" rel="noopener noreferrer" tabindex={isClone ? '-1' : undefined} aria-hidden={isClone ? 'true' : undefined} class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-full border hover:opacity-80 transition-opacity" style="border-color: var(--fg); background: var(--fg); color: var(--bg)">{isAr ? 'عرض' : 'View'} <span aria-hidden="true">↗</span></a>
                {p.hostedUrl && p.hostedUrl !== p.link && (
                  <a href={p.hostedUrl} target="_blank" rel="noopener noreferrer" tabindex={isClone ? '-1' : undefined} aria-hidden={isClone ? 'true' : undefined} class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-full border" style="border-color: var(--border); color: var(--fg-2); background: transparent">Live</a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    overflow-x: clip;
    max-width: 100%;
    width: 100%;
    padding: 0.5rem 0 1rem;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    /* Keep marquee LTR even on RTL pages to avoid scrollbar flipping */
    direction: ltr;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  }
  /* Ensure section itself never causes horizontal scroll, especially in RTL */
  :global(html[dir="rtl"]) .marquee {
    direction: ltr;
  }
  :global(#projects) {
    overflow: hidden;
    overflow-x: clip;
    max-width: 100%;
  }
  .marquee.is-dragging {
    cursor: grabbing;
  }
  .marquee-track {
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
    animation: marquee var(--marquee-duration, 40s) linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  .marquee.is-dragging .marquee-track {
    animation-play-state: paused !important;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; transform: none; }
    .marquee { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .marquee::-webkit-scrollbar { display: none; }
  }
  @media (max-width: 640px) {
    .marquee-track { gap: 16px; }
  }
</style>

<script>
  // Fixed drag: no snap-back to first project. Resumes smoothly from dragged offset via negative animation-delay.
  (() => {
    const marquees = document.querySelectorAll('[data-marquee]');
    marquees.forEach((marquee) => {
      const track = marquee.querySelector('.marquee-track');
      if (!track) return;

      let isDown = false;
      let hasDragged = false;
      let startX = 0;
      let startTranslate = 0;
      let currentTranslate = 0;
      let animationPaused = false;

      // respect reduced-motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;

      function getTranslateX(el) {
        const style = window.getComputedStyle(el);
        const tr = style.transform;
        if (!tr || tr === 'none') return 0;
        const m = tr.match(/matrix.*\((.+)\)/);
        if (!m) return 0;
        const vals = m[1].split(', ');
        return parseFloat(vals[4] ?? vals[12] ?? 0);
      }

      function pauseAuto() {
        if (!animationPaused) {
          currentTranslate = getTranslateX(track);
          track.style.animation = 'none';
          track.style.transform = `translateX(${currentTranslate}px)`;
          void track.offsetWidth;
          animationPaused = true;
        }
      }

      function resumeAuto() {
        if (!animationPaused) return;
        const half = track.scrollWidth / 2;
        if (half <= 0) {
          track.style.animation = '';
          track.style.transform = '';
          animationPaused = false;
          return;
        }
        const style = getComputedStyle(track);
        const durStr = style.getPropertyValue('--marquee-duration') || '40s';
        const duration = parseFloat(durStr) || 40;
        // normalize offset to 0..half
        let norm = ((-currentTranslate % half) + half) % half;
        const progress = norm / half; // 0..1
        const delay = -progress * duration;
        track.style.transform = '';
        track.style.animation = 'none';
        void track.offsetWidth;
        track.style.animation = `marquee ${duration}s linear infinite`;
        track.style.animationDelay = `${delay}s`;
        animationPaused = false;
        hasDragged = false;
      }

      marquee.addEventListener('pointerdown', (e) => {
        // only left button / touch
        if (e.button !== undefined && e.button !== 0) return;
        isDown = true;
        hasDragged = false;
        marquee.classList.add('is-dragging');
        try { marquee.setPointerCapture(e.pointerId); } catch {}
        pauseAuto();
        startX = e.clientX;
        startTranslate = currentTranslate;
        e.preventDefault();
      });

      marquee.addEventListener('pointermove', (e) => {
        if (!isDown) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 5) hasDragged = true;
        const next = startTranslate + dx;
        const half = track.scrollWidth / 2;
        let clamped = next;
        if (clamped > 180) clamped = 180;
        if (clamped < -half - 180) clamped = -half - 180;
        currentTranslate = clamped;
        track.style.transform = `translateX(${clamped}px)`;
      });

      const endDrag = (e) => {
        if (!isDown) return;
        isDown = false;
        marquee.classList.remove('is-dragging');
        try { marquee.releasePointerCapture(e.pointerId); } catch {}
        // if we dragged, suppress next click on links (avoid accidental navigation while dragging)
        if (hasDragged) {
          const handler = (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            marquee.removeEventListener('click', handler, true);
          };
          marquee.addEventListener('click', handler, true);
          setTimeout(() => marquee.removeEventListener('click', handler, true), 0);
        }
        // keep position for 1.2s to allow clicking, then resume smoothly
        setTimeout(() => {
          resumeAuto();
        }, 1200);
      };

      marquee.addEventListener('pointerup', endDrag);
      marquee.addEventListener('pointerleave', endDrag);
      marquee.addEventListener('pointercancel', endDrag);

      marquee.addEventListener('touchmove', (e) => {
        if (isDown) e.preventDefault();
      }, { passive: false });
    });
  })();
</script>
